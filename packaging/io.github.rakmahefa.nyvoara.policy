<?xml version="1.0" encoding="UTF-8"?>
<!--
  NyVoara — action polkit de l'aide privilégiée.

  L'interface graphique tourne SANS privilèges afin de conserver
  l'accès au bus de session D-Bus et à l'icône de notification.

  Les opérations nécessitant des privilèges administrateur sont
  déléguées à un processus auxiliaire lancé avec pkexec.

  Deux modes sont prévus :
  - sysfs-write : écriture contrôlée dans les fichiers sysfs.
  - apply       : application d'un profil de configuration.

  Le binaire vérifie strictement les chemins et les valeurs autorisés
  dans core::sysfs_writable.

  Les chemins autorisés sont :
  - /sys/devices/system/cpu/
  - /sys/class/drm/
  - /sys/class/power_supply/
-->
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>NyVoara</vendor>
  <vendor_url>https://github.com/rakmahefa/surface-core-tuner</vendor_url>

  <action id="io.github.rakmahefa.nyvoara.sysfs">
    <description>Apply NyVoara performance settings (CPU/GPU/battery)</description>
    <description xml:lang="fr">Appliquer les réglages NyVoara (CPU/GPU/batterie)</description>
    <message>Authentication is required to tune CPU, GPU and power settings</message>
    <message xml:lang="fr">Une authentification est requise pour régler le CPU, le GPU et l'énergie</message>

    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/opt/nyvoara/nyvoara</annotate>
  </action>

</policyconfig>
